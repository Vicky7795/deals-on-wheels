{
  "name": "deals-on-wheels-root",
  "version": "1.0.0",
  "description": "Full-stack vehicle marketplace application - Deals on Wheels",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --include=dev --prefix frontend",
